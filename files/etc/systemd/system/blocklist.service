[Unit]
Description=Blocklist: nftables blocks (geo, attackers, proxy) from /etc/nftables.d
Documentation=man:nft(8)
# Loads ONLY its own tables - no 'flush ruleset', so Docker, firewalld and ufw are untouched.
DefaultDependencies=no
Wants=network-pre.target
After=local-fs.target nftables.service firewalld.service
Before=network-pre.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/blocklist load
ExecReload=/usr/local/sbin/blocklist load
ExecStop=/usr/local/sbin/blocklist unload
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
