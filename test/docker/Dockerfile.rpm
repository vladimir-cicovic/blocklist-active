# Test "server": RHEL family (AlmaLinux, Rocky, CentOS Stream, Fedora, Oracle, Amazon).
# nftables, python3 and iproute are deliberately NOT installed - install.sh does that.
# systemd-resolved is masked: inside a container it cannot resolve Docker's internal names.
ARG BASE=almalinux:9
FROM ${BASE}
ENV container=docker
RUN dnf -y install systemd openssh-server \
 && dnf clean all \
 && systemctl mask systemd-udevd.service systemd-udevd-kernel.socket systemd-udevd-control.socket \
      systemd-modules-load.service sys-kernel-debug.mount sys-kernel-tracing.mount sys-kernel-config.mount \
      getty.target console-getty.service systemd-firstboot.service systemd-remount-fs.service systemd-resolved.service \
      dnf-makecache.timer >/dev/null 2>&1 ; \
    systemctl enable sshd.service \
 && mkdir -p /root/.ssh && chmod 700 /root/.ssh
STOPSIGNAL SIGRTMIN+3
CMD ["/usr/sbin/init"]
