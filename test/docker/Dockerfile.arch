# Test "server": Arch Linux (pacman).
ARG BASE=archlinux:latest
FROM ${BASE}
ENV container=docker
RUN pacman -Sy --noconfirm --needed systemd openssh \
 && pacman -Scc --noconfirm \
 && systemctl mask systemd-udevd.service systemd-udevd-kernel.socket systemd-udevd-control.socket \
      systemd-modules-load.service sys-kernel-debug.mount sys-kernel-tracing.mount sys-kernel-config.mount \
      getty.target console-getty.service systemd-firstboot.service systemd-remount-fs.service systemd-resolved.service >/dev/null 2>&1 ; \
    systemctl enable sshd.service \
 && mkdir -p /root/.ssh && chmod 700 /root/.ssh
STOPSIGNAL SIGRTMIN+3
CMD ["/usr/lib/systemd/systemd"]
